# Server
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Prisma runtime (pooled Neon URL recommended)
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/neondb?sslmode=require"

# Prisma CLI / migrations (direct Neon URL)
DIRECT_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# AI chat endpoint (/api/chat)
OPENAI_API_KEY=""

# Cloudinary image URL generation helper (optional)
CLOUDINARY_CLOUD_NAME=""
# Optional alias used by some web/client code
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# QR deep-link and public scan URLs
APP_DEEPLINK_SCHEME="instadiumapp"
PUBLIC_API_BASE_URL="http://localhost:4000"
# Optional browser fallback when app is not installed
PUBLIC_WEB_FALLBACK_URL=""

# Neon Auth JWT verification (required for protected endpoints)
# Example issuer: https://<your-neon-auth-domain>
# Example JWKS URL: https://<your-neon-auth-domain>/.well-known/jwks.json
NEON_AUTH_ISSUER=""
NEON_AUTH_JWKS_URL=""
# Optional expected audience claim
NEON_AUTH_AUDIENCE=""
# Optional comma-separated admin allowlist for write/admin routes
NEON_AUTH_ADMIN_EMAILS=""
