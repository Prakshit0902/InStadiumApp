# Expo app will call this backend base URL
# Android Emulator: http://10.0.2.2:4000
# Physical device on same Wi-Fi: http://<your-laptop-ip>:4000
EXPO_PUBLIC_API_BASE_URL="http://10.0.2.2:4000"

# Neon Auth endpoint used by the mobile login/signup flow
EXPO_PUBLIC_NEON_AUTH_URL="https://ep-still-resonance-aj9n30qx.neonauth.c-3.us-east-2.aws.neon.tech/neondb/auth"
# Must be an absolute http(s) URL for Neon Auth callback validation
EXPO_PUBLIC_APP_CALLBACK_URL="https://ep-still-resonance-aj9n30qx.neonauth.c-3.us-east-2.aws.neon.tech/auth/callback"

# Optional: enables Cloudinary URL optimization for stadium images
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=""
