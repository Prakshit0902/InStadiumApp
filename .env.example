# Expo app will call this backend base URL
# Android Emulator: http://10.0.2.2:4000
# Physical device on same Wi-Fi: http://<your-laptop-ip>:4000
EXPO_PUBLIC_API_BASE_URL="http://10.0.2.2:4000"

# Clerk publishable key for Expo app auth
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"

# Clerk SSO callback path for Expo OAuth redirects
EXPO_PUBLIC_CLERK_SSO_CALLBACK_PATH="sso-callback"

# Optional: enables Cloudinary URL optimization for stadium images
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=""
